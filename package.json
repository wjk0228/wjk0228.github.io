{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "check": "astro check",
    "check:content": "node scripts/check-content.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "verify": "npm run check && npm run check:content && npm run build && npm run check:dist",
    "preview": "astro preview",
    "migrate:hexo": "node scripts/migrate-hexo.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
