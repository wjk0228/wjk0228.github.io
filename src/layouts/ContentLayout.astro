---
import BaseLayout from './BaseLayout.astro';
import KnowledgeCard from '../components/KnowledgeCard.astro';
import { domainLabel, formatDate, site, statusLabel } from '../data/site';
import { entryHref, type AnyEntry } from '../utils/content';

interface Props {
  data: {
    title: string;
    description: string;
    domain: keyof typeof domainLabel;
    status: keyof typeof statusLabel;
    created: Date;
    updated: Date;
    topics: string[];
    tags: string[];
    sourceType: string;
    series?: string;
  };
  headings?: { depth: number; slug: string; text: string }[];
  related?: AnyEntry[];
  seriesEntries?: AnyEntry[];
  currentId?: string;
  currentCollection?: string;
}

const {
  data,
  headings = [],
  related = [],
  seriesEntries = [],
  currentId,
  currentCollection,
} = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const seriesIndex = seriesEntries.findIndex(
  (entry) => entry.id === currentId && entry.collection === currentCollection,
);
const previousEntry = seriesIndex > 0 ? seriesEntries[seriesIndex - 1] : undefined;
const nextEntry =
  seriesIndex >= 0 && seriesIndex < seriesEntries.length - 1
    ? seriesEntries[seriesIndex + 1]
    : undefined;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? site.domain);
const topicTags = [...new Set([...data.topics, ...data.tags])];
const articleStructuredData = {
  '@type': 'Article',
  '@id': `${canonicalURL.href}#article`,
  headline: data.title,
  description: data.description,
  url: canonicalURL.href,
  mainEntityOfPage: canonicalURL.href,
  datePublished: data.created.toISOString(),
  dateModified: data.updated.toISOString(),
  inLanguage: 'zh-CN',
  articleSection: domainLabel[data.domain],
  keywords: topicTags.join(', '),
  author: { '@id': `${site.domain}/#person` },
  isPartOf: { '@id': `${site.domain}/#website` },
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  publishedTime={data.created}
  modifiedTime={data.updated}
  structuredData={articleStructuredData}
>
  <article
    class="content-shell container"
    data-pagefind-body
  >
    <header class="content-header">
      <div class="content-kicker">
        <span>{domainLabel[data.domain]}</span>
        <span>·</span>
        <span>{statusLabel[data.status]}</span>
      </div>
      <h1 data-pagefind-meta="title">{data.title}</h1>
      <p data-pagefind-meta="description">{data.description}</p>
      <span
        class="search-meta"
        data-pagefind-meta="domain"
        data-pagefind-filter="领域"
      >
        {domainLabel[data.domain]}
      </span>
      <span
        class="search-meta"
        data-pagefind-meta="status"
        data-pagefind-filter="状态"
      >
        {statusLabel[data.status]}
      </span>
      <div class="content-meta">
        <span>创建于 {formatDate(data.created)}</span>
        <span>更新于 {formatDate(data.updated)}</span>
        {data.sourceType === 'migration' && <span>由旧站迁移</span>}
      </div>
    </header>
    <div class="content-layout">
      <div class="prose">
        <slot />
      </div>
      <aside>
        {visibleHeadings.length > 0 && (
          <div class="toc">
            <span class="aside-label">本页目录</span>
            <nav aria-label="本页目录">
              {visibleHeadings.map((heading) => (
                <a
                  class:list={{ subheading: heading.depth === 3 }}
                  href={`#${heading.slug}`}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </div>
        )}
        <span class="aside-label">主题</span>
        <div class="tag-list">
          {topicTags.map((item) => (
            <a class="tag" href={`/tags/${encodeURIComponent(item)}/`} data-pagefind-filter="标签">
              {item}
            </a>
          ))}
        </div>
        <a href="/" class="back-link">← 返回知识库首页</a>
      </aside>
    </div>

    {data.series && seriesEntries.length > 1 && (
      <section class="series-nav" data-pagefind-ignore>
        <div>
          <span>系列</span>
          <strong>{data.series}</strong>
          <small>{seriesIndex + 1} / {seriesEntries.length}</small>
        </div>
        <nav aria-label={`${data.series}系列导航`}>
          {previousEntry ? (
            <a href={entryHref(previousEntry)}>
              <span>上一篇</span>
              <strong>{previousEntry.data.title}</strong>
            </a>
          ) : <i></i>}
          {nextEntry ? (
            <a href={entryHref(nextEntry)}>
              <span>下一篇</span>
              <strong>{nextEntry.data.title}</strong>
            </a>
          ) : <i></i>}
        </nav>
      </section>
    )}

    {related.length > 0 && (
      <section class="related" data-pagefind-ignore>
        <div class="related-heading">
          <div>
            <span class="aside-label">Related knowledge</span>
            <h2>继续阅读</h2>
          </div>
          <a href="/knowledge/">查看全部知识 ↗</a>
        </div>
        <div class="related-grid">
          {related.map((entry) => <KnowledgeCard entry={entry} />)}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .content-shell {
    padding-top: 92px;
  }

  .content-header {
    max-width: 900px;
    padding-bottom: 52px;
    border-bottom: 1px solid var(--line);
  }

  .search-meta {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .content-kicker {
    display: flex;
    gap: 9px;
    color: var(--teal);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 24px 0;
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 7vw, 5.8rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 1;
  }

  .content-header > p {
    max-width: 720px;
    color: var(--ink-soft);
    font-size: 1.12rem;
  }

  .content-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 26px;
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .content-layout {
    display: grid;
    grid-template-columns: minmax(0, 760px) 220px;
    gap: 80px;
    padding-top: 56px;
  }

  aside {
    position: sticky;
    top: 104px;
    align-self: start;
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .toc {
    margin-bottom: 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }

  .toc nav {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .toc a {
    color: var(--ink-soft);
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .toc a:hover {
    color: var(--teal);
  }

  .toc a.subheading {
    padding-left: 13px;
  }

  .aside-label {
    display: block;
    margin-bottom: 14px;
    color: var(--ink-soft);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .back-link {
    display: block;
    margin-top: 28px;
    color: var(--teal);
    font-size: 0.78rem;
    font-weight: 750;
  }

  .series-nav,
  .related {
    margin-top: 80px;
    padding-top: 34px;
    border-top: 1px solid var(--line);
  }

  .series-nav {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 48px;
  }

  .series-nav > div {
    display: flex;
    flex-direction: column;
    align-items: start;
  }

  .series-nav > div span,
  .series-nav nav span {
    color: var(--teal);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .series-nav > div strong {
    margin-top: 8px;
    font-family: var(--font-serif);
    font-size: 1.35rem;
  }

  .series-nav > div small {
    margin-top: 6px;
    color: var(--ink-soft);
  }

  .series-nav nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .series-nav nav a {
    display: flex;
    min-height: 110px;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .series-nav nav a:hover {
    border-color: var(--teal);
  }

  .series-nav nav strong {
    font-family: var(--font-serif);
    font-size: 1.1rem;
  }

  .related-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 26px;
  }

  .related-heading h2 {
    margin: 5px 0 0;
    font-family: var(--font-serif);
    font-size: 2.3rem;
    font-weight: 500;
  }

  .related-heading > a {
    color: var(--teal);
    font-size: 0.78rem;
    font-weight: 750;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  @media (max-width: 900px) {
    .content-layout {
      grid-template-columns: 1fr;
    }

    aside {
      position: static;
      padding: 24px 0 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .series-nav {
      grid-template-columns: 1fr;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 580px) {
    .series-nav nav {
      grid-template-columns: 1fr;
    }
  }
</style>
