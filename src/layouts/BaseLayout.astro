---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title = site.title,
  description = site.description,
  image = '/og.png',
  imageAlt = 'Kun 的个人知识库：技术、学习、金融与观察',
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  structuredData,
} = Astro.props;
const pageTitle = title === site.title ? title : `${title} · ${site.title}`;
const baseURL = Astro.site ?? new URL(site.domain);
const canonicalURL = new URL(Astro.url.pathname, baseURL);
const imageURL = new URL(image, baseURL);
const structuredGraph = [
  {
    '@type': 'Person',
    '@id': `${site.domain}/#person`,
    name: site.author,
    url: site.domain,
    sameAs: ['https://github.com/wjk0228'],
  },
  {
    '@type': 'WebSite',
    '@id': `${site.domain}/#website`,
    name: site.title,
    alternateName: site.shortTitle,
    description: site.description,
    url: site.domain,
    inLanguage: 'zh-CN',
    author: { '@id': `${site.domain}/#person` },
    potentialAction: {
      '@type': 'SearchAction',
      target: `${site.domain}/search/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  ...(structuredData ? [structuredData] : []),
];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': structuredGraph,
}).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0e3142" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.title} RSS`}
      href={new URL('/rss.xml', baseURL)}
    />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('pkb-theme');
        } catch {}
        const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = saved || preferred;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      const themeToggle = document.querySelector('.theme-toggle');
      const syncThemeToggle = () => {
        themeToggle?.setAttribute(
          'aria-pressed',
          String(document.documentElement.dataset.theme === 'dark'),
        );
      };
      syncThemeToggle();
      themeToggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('pkb-theme', next);
        } catch {}
        syncThemeToggle();
      });
    </script>
  </body>
</html>
