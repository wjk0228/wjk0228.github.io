---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeCard from '../../components/KnowledgeCard.astro';
import {
  collectionLabel,
  domainLabel,
  statusLabel,
} from '../../data/site';
import { getAllEntries, sortByUpdated } from '../../utils/content';

const entries = sortByUpdated(await getAllEntries());
const domains = [...new Set(entries.map((entry) => entry.data.domain))];
const collections = [...new Set(entries.map((entry) => entry.collection))];
const statuses = [...new Set(entries.map((entry) => entry.data.status))];
const tags = [...new Set(entries.flatMap((entry) => [...entry.data.topics, ...entry.data.tags]))]
  .sort((a, b) => a.localeCompare(b, 'zh-CN'));
---

<BaseLayout
  title="知识库"
  description="浏览、筛选和发现技术、考试、金融与观察领域的全部知识内容。"
>
  <section class="knowledge-hero container" data-pagefind-ignore>
    <div>
      <p class="eyebrow">Knowledge library</p>
      <h1>全部知识，<em>一个入口。</em></h1>
    </div>
    <p>
      按领域、内容类型、成熟度和关键词快速定位内容。知识会持续从初步记录走向长期维护。
    </p>
  </section>

  <section class="library container" data-pagefind-ignore>
    <aside class="filters glass">
      <div class="filter-heading">
        <span>筛选知识</span>
        <button id="reset-filters" type="button">重置</button>
      </div>

      <label>
        <span>标题与关键词</span>
        <input id="library-query" type="search" placeholder="例如：数据结构、MBA、利率" />
      </label>

      <label>
        <span>知识领域</span>
        <select id="domain-filter">
          <option value="">全部领域</option>
          {domains.map((domain) => <option value={domain}>{domainLabel[domain]}</option>)}
        </select>
      </label>

      <label>
        <span>内容类型</span>
        <select id="collection-filter">
          <option value="">全部类型</option>
          {collections.map((collection) => (
            <option value={collection}>{collectionLabel[collection]}</option>
          ))}
        </select>
      </label>

      <label>
        <span>成熟度</span>
        <select id="status-filter">
          <option value="">全部状态</option>
          {statuses.map((status) => <option value={status}>{statusLabel[status]}</option>)}
        </select>
      </label>

      <div class="quick-tags">
        <span>常用标签</span>
        <div>
          {tags.slice(0, 12).map((tag) => (
            <button type="button" data-tag={tag}>{tag}</button>
          ))}
        </div>
      </div>

      <a class="search-cta" href="/search/">需要查找正文？使用全文搜索 →</a>
    </aside>

    <div class="library-results">
      <div class="results-heading">
        <p><strong id="result-count">{entries.length}</strong> 条知识</p>
        <a href="/tags/">查看标签索引 ↗</a>
      </div>

      <div class="knowledge-list" id="knowledge-list">
        {entries.map((entry) => (
          <div
            class="knowledge-item"
            data-domain={entry.data.domain}
            data-collection={entry.collection}
            data-status={entry.data.status}
            data-search={[
              entry.data.title,
              entry.data.description,
              ...entry.data.topics,
              ...entry.data.tags,
              entry.data.series ?? '',
            ].join(' ').toLocaleLowerCase('zh-CN')}
          >
            <KnowledgeCard entry={entry} />
          </div>
        ))}
      </div>

      <div class="empty-state" id="empty-state" hidden>
        <strong>没有匹配的知识条目</strong>
        <p>尝试减少筛选条件，或者使用全文搜索查找正文内容。</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const queryInput = document.querySelector<HTMLInputElement>('#library-query');
  const domainSelect = document.querySelector<HTMLSelectElement>('#domain-filter');
  const collectionSelect = document.querySelector<HTMLSelectElement>('#collection-filter');
  const statusSelect = document.querySelector<HTMLSelectElement>('#status-filter');
  const resetButton = document.querySelector<HTMLButtonElement>('#reset-filters');
  const count = document.querySelector<HTMLElement>('#result-count');
  const emptyState = document.querySelector<HTMLElement>('#empty-state');
  const items = [...document.querySelectorAll<HTMLElement>('.knowledge-item')];
  const tagButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];

  function applyFilters() {
    const query = queryInput?.value.trim().toLocaleLowerCase('zh-CN') ?? '';
    const domain = domainSelect?.value ?? '';
    const collection = collectionSelect?.value ?? '';
    const status = statusSelect?.value ?? '';
    let visible = 0;

    items.forEach((item) => {
      const matches =
        (!query || item.dataset.search?.includes(query)) &&
        (!domain || item.dataset.domain === domain) &&
        (!collection || item.dataset.collection === collection) &&
        (!status || item.dataset.status === status);
      item.hidden = !matches;
      if (matches) visible += 1;
    });

    if (count) count.textContent = String(visible);
    if (emptyState) emptyState.hidden = visible !== 0;
  }

  [queryInput, domainSelect, collectionSelect, statusSelect].forEach((control) => {
    control?.addEventListener('input', applyFilters);
  });

  tagButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (queryInput) queryInput.value = button.dataset.tag ?? '';
      tagButtons.forEach((item) => item.classList.toggle('active', item === button));
      applyFilters();
    });
  });

  resetButton?.addEventListener('click', () => {
    if (queryInput) queryInput.value = '';
    if (domainSelect) domainSelect.value = '';
    if (collectionSelect) collectionSelect.value = '';
    if (statusSelect) statusSelect.value = '';
    tagButtons.forEach((button) => button.classList.remove('active'));
    applyFilters();
  });
</script>

<style>
  .knowledge-hero {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: end;
    gap: 70px;
    padding-top: 110px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(3.4rem, 8vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.96;
  }

  h1 em {
    color: var(--teal);
    font-weight: inherit;
  }

  .knowledge-hero > p {
    color: var(--ink-soft);
    font-size: 1.02rem;
  }

  .library {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    align-items: start;
    gap: 42px;
    padding-top: 76px;
  }

  .filters {
    position: sticky;
    top: 98px;
    padding: 24px;
    border-radius: var(--radius-md);
  }

  .filter-heading,
  .results-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .filter-heading {
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .filter-heading button {
    padding: 0;
    color: var(--teal);
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 0.72rem;
  }

  label {
    display: block;
    margin-top: 16px;
  }

  label > span,
  .quick-tags > span {
    display: block;
    margin-bottom: 7px;
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 750;
  }

  input,
  select {
    width: 100%;
    min-height: 42px;
    padding: 0 11px;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 10px;
    outline: none;
    background: var(--surface-solid);
    font-size: 0.78rem;
  }

  input:focus,
  select:focus {
    border-color: var(--teal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--teal) 12%, transparent);
  }

  .quick-tags {
    margin-top: 22px;
  }

  .quick-tags > div {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .quick-tags button {
    padding: 4px 8px;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    font-size: 0.66rem;
  }

  .quick-tags button:hover,
  .quick-tags button.active {
    color: var(--teal);
    border-color: var(--teal);
  }

  .search-cta {
    display: block;
    margin-top: 24px;
    color: var(--teal);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .results-heading {
    min-height: 48px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }

  .results-heading p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .results-heading strong {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.5rem;
  }

  .results-heading a {
    color: var(--teal);
    font-size: 0.74rem;
    font-weight: 750;
  }

  .knowledge-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .knowledge-item[hidden] {
    display: none;
  }

  .empty-state {
    padding: 80px 24px;
    text-align: center;
    border: 1px dashed var(--line);
    border-radius: var(--radius-md);
  }

  .empty-state strong {
    font-family: var(--font-serif);
    font-size: 1.6rem;
  }

  .empty-state p {
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  @media (max-width: 880px) {
    .knowledge-hero,
    .library {
      grid-template-columns: 1fr;
    }

    .filters {
      position: static;
    }
  }

  @media (max-width: 620px) {
    .knowledge-list {
      grid-template-columns: 1fr;
    }
  }
</style>
