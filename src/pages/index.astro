---
import BaseLayout from '../layouts/BaseLayout.astro';
import KnowledgeCard from '../components/KnowledgeCard.astro';
import { getAllEntries, sortByUpdated } from '../utils/content';

const entries = sortByUpdated(await getAllEntries());

const domains = [
  {
    index: '01',
    title: '技术成长',
    en: 'Technology',
    href: '/technology/',
    description: '从编程语言、工程实践到系统设计，把解决问题的过程沉淀为可复用的方法。',
    topics: ['Java / TypeScript', '架构与数据库', 'AI 与效率工具'],
  },
  {
    index: '02',
    title: '考试学习',
    en: 'Study',
    href: '/study/',
    description: '以目标、计划、知识点、真题和复盘组成完整的考试学习闭环。',
    topics: ['软考软件设计师', 'MBA 管理类联考', '学习方法'],
  },
  {
    index: '03',
    title: '金融知识',
    en: 'Finance',
    href: '/finance/',
    description: '围绕银行客户经理工作，建立金融、信贷、财务分析和风险管理知识体系。',
    topics: ['银行业务', '财务与信贷', '宏观与市场'],
  },
  {
    index: '04',
    title: '观察分享',
    en: 'Insights',
    href: '/insights/',
    description: '记录金融热点、市场趋势、科技变化，以及这些变化带来的现实影响。',
    topics: ['金融热点', '市场趋势', '科技观察'],
  },
];

const currentFocus = [
  { code: 'MBA', title: 'MBA 备考体系', note: '从考试概览到数学、逻辑、写作与英语二的阶段计划。' },
  { code: 'FIN', title: '银行与金融知识', note: '围绕客户分析、财务报表、授信风险建立专业底座。' },
  { code: 'DEV', title: '工程能力复利', note: '持续整理开发实践、问题排查、架构判断与 AI 工具应用。' },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Personal knowledge system · 2026</p>
      <h1 class="display">把经验，整理成<br /><span class="accent">可以复用</span>的知识。</h1>
      <div class="hero-bottom">
        <p>
          一个面向长期成长的个人知识库：记录开发技术、考试备考、银行与金融专业知识，
          也持续观察市场与科技正在发生的变化。
        </p>
        <div class="button-row">
          <a class="button button-primary" href="#knowledge-map">浏览知识地图 <span>↓</span></a>
          <a class="button" href="/about/">了解本站 <span>↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="signal-strip">
    <div class="container signal-grid">
      <div><strong>13</strong><span>旧站笔记待整理</span></div>
      <div><strong>04</strong><span>核心知识领域</span></div>
      <div><strong>01</strong><span>统一知识系统</span></div>
      <div><strong>∞</strong><span>持续学习与更新</span></div>
    </div>
  </section>

  <section class="section" id="knowledge-map">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Knowledge map</p>
          <h2 class="section-title">四条长期成长主线</h2>
        </div>
        <p class="section-lead">
          内容不再只是按时间堆叠，而是进入领域、主题、系列和学习路线，形成可以持续迭代的结构。
        </p>
      </div>
      <div class="domain-list">
        {domains.map((domain) => (
          <a class="domain-row" href={domain.href}>
            <span class="domain-index">{domain.index}</span>
            <div>
              <span class="domain-en">{domain.en}</span>
              <h3>{domain.title}</h3>
            </div>
            <p>{domain.description}</p>
            <div class="domain-topics">
              {domain.topics.map((topic) => <span>{topic}</span>)}
            </div>
            <span class="domain-arrow">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section focus">
    <div class="container focus-grid">
      <div class="focus-intro">
        <p class="eyebrow">Ongoing themes</p>
        <h2 class="section-title">长期关注主题</h2>
        <p class="section-lead">
          围绕职业、学习与实践持续积累，让每次记录都能连接到已有知识。
        </p>
      </div>
      <div class="focus-items">
        {currentFocus.map((item) => (
          <article>
            <div class="focus-marker">
              <span>{item.code}</span>
            </div>
            <div>
              <h3>{item.title}</h3>
              <p>{item.note}</p>
            </div>
            <span class="phase">持续更新</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Latest knowledge</p>
          <h2 class="section-title">最近更新</h2>
        </div>
        <a class="text-link" href="/knowledge/">浏览全部知识 ↗</a>
      </div>
      <div class="knowledge-grid">
        {entries.slice(0, 6).map((entry) => <KnowledgeCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section manifesto">
    <div class="container manifesto-inner">
      <p class="eyebrow">Working principles</p>
      <blockquote>
        “不是收藏更多信息，而是把学习、实践与思考连接起来，形成下一次可以直接调用的判断。”
      </blockquote>
      <div class="principles">
        <span>结构优先</span>
        <span>来源可追溯</span>
        <span>持续更新</span>
        <span>隐私与合规</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 128px 0 88px;
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 600px) auto;
    align-items: end;
    justify-content: space-between;
    gap: 44px;
    margin-top: 54px;
  }

  .hero-bottom > p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.08rem;
  }

  .hero-bottom .button-row {
    margin: 0;
  }

  .signal-strip {
    border-block: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 54%, transparent);
  }

  .signal-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .signal-grid > div {
    display: flex;
    min-height: 120px;
    flex-direction: column;
    justify-content: center;
    padding: 22px 30px;
    border-right: 1px solid var(--line);
  }

  .signal-grid > div:first-child {
    border-left: 1px solid var(--line);
  }

  .signal-grid strong {
    font-family: var(--font-serif);
    font-size: 2.15rem;
    font-weight: 500;
    line-height: 1;
  }

  .signal-grid span {
    margin-top: 9px;
    color: var(--ink-soft);
    font-size: 0.72rem;
  }

  .domain-list {
    border-top: 1px solid var(--line);
  }

  .domain-row {
    display: grid;
    grid-template-columns: 52px 180px minmax(220px, 1fr) 180px 36px;
    align-items: center;
    gap: 24px;
    min-height: 150px;
    border-bottom: 1px solid var(--line);
    transition: 180ms ease;
  }

  .domain-row:hover {
    padding-inline: 18px;
    background: var(--surface);
  }

  .domain-index,
  .domain-en {
    color: var(--gold);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .domain-row h3 {
    margin: 7px 0 0;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
  }

  .domain-row > p {
    color: var(--ink-soft);
    font-size: 0.88rem;
  }

  .domain-topics {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 4px;
    color: var(--ink-soft);
    font-size: 0.72rem;
  }

  .domain-arrow {
    color: var(--teal);
    font-size: 1.2rem;
  }

  .focus {
    background: color-mix(in srgb, var(--canvas-strong) 72%, transparent);
  }

  .focus-grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 80px;
  }

  .focus-items {
    border-top: 1px solid var(--line);
  }

  .focus-items article {
    display: grid;
    grid-template-columns: 84px 1fr auto;
    align-items: center;
    gap: 26px;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }

  .focus-marker span {
    color: var(--teal);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.12em;
  }

  .focus-items h3 {
    margin: 0 0 7px;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
  }

  .focus-items p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.82rem;
  }

  .phase {
    padding: 5px 10px;
    color: var(--teal);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 750;
  }

  .knowledge-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .manifesto {
    padding-bottom: 120px;
  }

  .manifesto-inner {
    padding: 72px;
    color: #edf6f4;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 85% 20%, rgba(71, 177, 168, 0.24), transparent 20rem),
      #0e3142;
    box-shadow: var(--shadow);
  }

  .manifesto .eyebrow {
    color: #75cbc5;
  }

  blockquote {
    max-width: 950px;
    margin: 40px 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }

  .principles {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .principles span {
    padding: 7px 12px;
    color: #b9cfce;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    font-size: 0.72rem;
  }

  @media (max-width: 960px) {
    .hero-bottom,
    .focus-grid {
      grid-template-columns: 1fr;
    }

    .domain-row {
      grid-template-columns: 42px 160px 1fr 32px;
    }

    .domain-topics {
      display: none;
    }

    .knowledge-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .hero {
      padding: 88px 0 68px;
    }

    .signal-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .signal-grid > div {
      border-bottom: 1px solid var(--line);
    }

    .domain-row {
      grid-template-columns: 36px 1fr 28px;
      gap: 12px;
      padding: 24px 0;
    }

    .domain-row:hover {
      padding-inline: 10px;
    }

    .domain-row > p {
      display: none;
    }

    .focus-items article {
      grid-template-columns: 70px 1fr;
    }

    .phase {
      display: none;
    }

    .knowledge-grid {
      grid-template-columns: 1fr;
    }

    .manifesto-inner {
      padding: 40px 26px;
    }
  }
</style>
