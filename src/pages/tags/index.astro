---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllEntries } from '../../utils/content';

const entries = await getAllEntries();
const counts = new Map<string, number>();
entries.forEach((entry) => {
  [...new Set([...entry.data.topics, ...entry.data.tags])].forEach((tag) => {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  });
});
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'));
---

<BaseLayout title="标签索引" description="按主题和标签探索个人知识库。" noindex>
  <section class="tag-shell container" data-pagefind-ignore>
    <p class="eyebrow">Tag index</p>
    <h1>从关键词，进入<br /><em>知识之间的连接。</em></h1>
    <p class="lead">标签用于跨越栏目连接相近内容；领域负责稳定分类，标签负责发现关系。</p>

    <div class="tag-cloud">
      {tags.map(([tag, count], index) => (
        <a
          href={`/tags/${encodeURIComponent(tag)}/`}
          style={`--rank: ${Math.min(1 + count * 0.1, 1.5)}; --delay: ${index * 15}ms`}
        >
          <span>{tag}</span>
          <small>{String(count).padStart(2, '0')}</small>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .tag-shell {
    padding-top: 108px;
  }

  h1 {
    max-width: 980px;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(3.2rem, 8vw, 6.8rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.98;
  }

  h1 em {
    color: var(--teal);
    font-weight: inherit;
  }

  .lead {
    max-width: 620px;
    margin: 30px 0 0 auto;
    color: var(--ink-soft);
  }

  .tag-cloud {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 72px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .tag-cloud a {
    display: flex;
    min-height: 130px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 54%, transparent);
    transition: 180ms ease var(--delay);
  }

  .tag-cloud a:hover {
    color: var(--teal);
    background: var(--surface-solid);
  }

  .tag-cloud span {
    font-family: var(--font-serif);
    font-size: calc(1.1rem * var(--rank));
    font-weight: 600;
  }

  .tag-cloud small {
    color: var(--gold);
    font-size: 0.66rem;
    font-weight: 800;
  }

  @media (max-width: 850px) {
    .tag-cloud {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .tag-cloud {
      grid-template-columns: 1fr;
    }
  }
</style>
