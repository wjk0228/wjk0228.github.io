---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeCard from '../../components/KnowledgeCard.astro';
import { getAllEntries, sortByUpdated, type AnyEntry } from '../../utils/content';

export async function getStaticPaths() {
  const entries = await getAllEntries(false);
  const tags = [...new Set(entries.flatMap((entry) => [...entry.data.topics, ...entry.data.tags]))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      entries: entries.filter((entry) =>
        [...entry.data.topics, ...entry.data.tags].includes(tag),
      ),
    },
  }));
}

const tag = Astro.params.tag ?? '';
const { entries } = Astro.props as { entries: AnyEntry[] };
const sortedEntries = sortByUpdated(entries);
---

<BaseLayout title={`标签：${tag}`} description={`浏览与“${tag}”相关的知识内容。`} noindex>
  <section class="tag-results container" data-pagefind-ignore>
    <a class="back" href="/tags/">← 全部标签</a>
    <p class="eyebrow">Tagged knowledge</p>
    <h1>“{tag}”</h1>
    <p>共连接 {sortedEntries.length} 条知识内容。</p>
    <div class="tag-grid">
      {sortedEntries.map((entry) => <KnowledgeCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .tag-results {
    padding-top: 96px;
  }

  .back {
    display: inline-block;
    margin-bottom: 48px;
    color: var(--teal);
    font-size: 0.78rem;
    font-weight: 750;
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.95;
  }

  .tag-results > p:not(.eyebrow) {
    color: var(--ink-soft);
  }

  .tag-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 54px;
  }

  @media (max-width: 900px) {
    .tag-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .tag-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
